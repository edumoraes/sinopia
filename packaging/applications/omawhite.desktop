[Desktop Entry]
Type=Application
Version=1.5
Name=Omawhite
GenericName=Whiteboard
Comment=Local-first whiteboard with export for the agent
Exec=omawhite
Icon=omawhite
Terminal=false
Categories=Graphics;2DGraphics;
Keywords=whiteboard;board;draw;sketch;canvas;agent;
# The window is matched by its app id; it does not take the launcher's
# activation token, so it promises no startup notification.
StartupWMClass=omawhite
StartupNotify=false
Actions=new;

[Desktop Action new]
Name=New Board
Exec=omawhite --new
