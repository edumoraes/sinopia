# Maintainer: Eduardo de Moraes <edumoraesdg@gmail.com>
pkgname=omawhite
pkgver=@VERSION@
pkgrel=@PKGREL@
pkgdesc="Local-first whiteboard for Omarchy with export for the agent"
arch=('x86_64')
url="https://github.com/edumoraes/omawhite"
license=('MIT' 'OFL-1.1-RFN')
install="${pkgname}.install"
# The binary links glibc and libgcc alone. The rest it loads at startup
# — the window through Wayland, the keyboard through xkbcommon, the GPU
# through Vulkan — so this list is the only place that says it needs them.
depends=('glibc' 'libgcc' 'wayland' 'libxkbcommon' 'vulkan-icd-loader' 'vulkan-driver')
makedepends=('cargo')
optdepends=('xdg-desktop-portal-gtk: a file chooser for Save and Open'
            'zenity: the question asked before closing unsaved work'
            'herdr: sending a board to an agent running in herdr'
            'tmux: sending a board to an agent running in tmux'
            'fontconfig: lettering the chrome in the desktop monospace face'
            'quickshell: the bar widget, on the Omarchy shell')
conflicts=('omawhite-bin' 'omawhite-git')
# Cargo.toml's release profile strips the binary: nothing to split out.
options=('!debug')
source=("${pkgname}-${pkgver}.tar.gz::${url}/releases/download/v${pkgver}/omawhite-v${pkgver}-source.tar.gz")
sha256sums=('@SOURCE_SHA256@')

prepare() {
  cd "omawhite-${pkgver}"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "omawhite-${pkgver}"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "omawhite-${pkgver}"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo test --frozen
}

package() {
  cd "omawhite-${pkgver}"
  sh packaging/install.sh target/release/omawhite "$pkgdir" "$pkgname"
}
